# MLflow (Bloco 4+)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=movielens-recommender

# DVC (Bloco 4+)
DVC_REMOTE_URL=./dvc-storage

# Data paths
DATA_DIR=./data
