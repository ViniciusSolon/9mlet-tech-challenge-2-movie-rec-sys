# ==============================================================================
# Python & Environment
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/

# Virtual Environments
.venv/
venv/
env/
ENV/
.devenv/

# Environment variables & secrets (NEVER commit secrets)
.env
.env.local
.env.*.local

# ==============================================================================
# ML / Data Pipeline (Never commit raw datasets or heavy binaries)
# ==============================================================================
# Raw datasets (MovieLens CSVs, ZIPs)
data/raw/*.csv
!data/raw/movies.csv
data/raw/**/*.csv
data/raw/*.zip
data/raw/external_metadata/*
!data/raw/external_metadata/.gitkeep

# Processed datasets (Parquets generated by DVC)
data/processed/*
!data/processed/.gitkeep
# Input of enrich_metadata (pré-etapa TMDB); not a DVC pipeline out
!data/processed/movie_metadata.parquet

# Execution Logs
data/logs/*
!data/logs/.gitkeep
*.log

# Model Checkpoints & Artifacts (model.pth is a DVC out)
models/*
!models/.gitkeep
artifacts/

# MLflow Experiment Tracking Database & Runs
mlruns/
mlflow.db
*.db
*.db-journal
*.sqlite

# DVC (Data Version Control) Cache & Storage
.dvc/cache/
.dvc/tmp/
dvc-storage/*
!dvc-storage/.gitkeep

# ==============================================================================
# Code Quality, Testing & Linter Caches
# ==============================================================================
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/

# ==============================================================================
# IDEs & System Files
# ==============================================================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
